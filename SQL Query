-- Run this in phpMyAdmin first
CREATE DATABASE IF NOT EXISTS report_system;
USE report_system;

CREATE TABLE reports (
    id INT AUTO_INCREMENT PRIMARY KEY,
    report_no VARCHAR(20) NOT NULL UNIQUE,
    report_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    description TEXT,
    file_path VARCHAR(255),
    approval_status ENUM('Pending', 'Approved', 'Rejected', 'In Progress') DEFAULT 'Pending',
    report_status ENUM('Draft', 'Pending Review', 'Complies') DEFAULT 'Draft',
    admin_notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

